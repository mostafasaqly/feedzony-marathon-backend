# Database (PostgreSQL / Neon)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Auth
JWT_SECRET="your_super_secret_key_min_32_chars"
JWT_EXPIRES_IN="7d"

# Server
PORT=3000
FRONTEND_URL="http://localhost:4200"

# Lemon Squeezy (billing & subscriptions)
LEMON_SQUEEZY_API_KEY=""        # API key from Settings > API
LEMON_SQUEEZY_STORE_ID=""       # numeric store id
LEMON_SQUEEZY_PRODUCT_ID=""     # numeric product id (informational)
LEMON_SQUEEZY_VARIANT_ID=""     # Pro plan VARIANT id — used to build checkouts; seeded onto the Pro plan
LEMON_SQUEEZY_WEBHOOK_SECRET="" # signing secret set when creating the webhook